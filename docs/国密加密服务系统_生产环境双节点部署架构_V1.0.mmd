flowchart TB
    %% ================= 样式定义（浅色主题） =================
    classDef biz fill:#E8F0FE,stroke:#1A73E8,stroke-width:2px,color:#174EA6,text-align:left;
    classDef sec fill:#FCE8E6,stroke:#C5221F,stroke-width:2px,color:#991B1B,text-align:left;
    classDef app fill:#FEF7E0,stroke:#B06000,stroke-width:2px,color:#7A4300,text-align:left;
    classDef data fill:#E6F4EA,stroke:#137333,stroke-width:2px,color:#0B5227,text-align:left;
    classDef ops fill:#F3E8FD,stroke:#681DA8,stroke-width:2px,color:#4A148C,text-align:left;
    classDef hw fill:#EAEEF3,stroke:#374151,stroke-width:2px,color:#1F2937,text-align:left;

    %% ================= ① 接入区 =================
    subgraph Z1["① 接入区 · 业务网 / 管理网"]
        direction LR
        BIZ["🧩 业务应用系统群<br/>种植业系统 · 畜牧业系统 · 电子证照系统 …<br/>AppID + Timestamp + Nonce + HMAC-SM3 请求直接签名<br/>AppSecret 不在网络传输"]
        ADM["👤 管理端浏览器（含三员角色）<br/>用户名 + 密码 + MFA 全局强制<br/>MFA_POLICY_MODE = REQUIRED<br/>Access Token 空闲 15min / 绝对 24h + AdminSession"]
    end

    %% ================= ② 安全接入区 =================
    subgraph Z2["② 安全接入区 · DMZ"]
        direction LR
        FW["🧱 防火墙 / DoS 防护<br/>业务网与管理网隔离<br/>密码设备网络独立<br/>IP 白名单可选，默认关闭"]
        LB["⚖️ 负载均衡 VIP · Keepalived 主备<br/>Nginx / 国产 Web Server<br/>国密 TLS 卸载 · SM2 双证书 · GB/T 38636<br/>回退通用 TLS 1.2+ 需审计并告警<br/>健康检查摘除故障节点"]
    end

    %% ================= ③ 应用服务区（双节点） =================
    subgraph Z3["③ 应用服务区 · 生产双节点 Active-Active（单机房内节点级冗余）"]
        direction LR

        subgraph ND1["应用节点 Node-1 · 麒麟/统信 + 海光/鲲鹏/飞腾/龙芯"]
            direction TB
            N1W["Nginx 反向代理 + 国密 TLS 卸载<br/>管理接口与业务接口分端口监听"]
            N1A["CryptoPlatform.App · ASP.NET Core 10 / .NET 10<br/>REST API 接入层：路由 · 参数校验 · 原子防重放 · 幂等<br/>密码服务：SM2 · SM3 · SM4 · HMAC-SM3 · RNG · 自检<br/>密钥管理：生命周期 · 版本 · 导入 · 备份恢复<br/>认证授权：请求签名 · Token · RBAC · 三员互斥<br/>管理控制台 · 风险控制 · 安全事件 · 审计写入"]
            N1K["🔑 密钥保护层 L0~L3<br/>L0 Unlock KEK → L1 Root Key → L2 Runtime KEK → L3 Data Key<br/>Software：主密码 + KDF + OS 安全存储 DPAPI/TPM<br/>HSM：ProviderClient 经厂商中间件访问"]
            N1T["📊 运行时旁路<br/>/metrics · Serilog 日志 · /health · /live · /ready"]
        end

        subgraph ND2["应用节点 Node-2 · 同构镜像，故障互备"]
            direction TB
            N2W["Nginx 反向代理 + 国密 TLS 卸载<br/>管理接口与业务接口分端口监听"]
            N2A["CryptoPlatform.App · ASP.NET Core 10 / .NET 10<br/>REST API 接入层：路由 · 参数校验 · 原子防重放 · 幂等<br/>密码服务：SM2 · SM3 · SM4 · HMAC-SM3 · RNG · 自检<br/>密钥管理：生命周期 · 版本 · 导入 · 备份恢复<br/>认证授权：请求签名 · Token · RBAC · 三员互斥<br/>管理控制台 · 风险控制 · 安全事件 · 审计写入"]
            N2K["🔑 密钥保护层 L0~L3<br/>L0 Unlock KEK → L1 Root Key → L2 Runtime KEK → L3 Data Key<br/>Software：主密码 + KDF + OS 安全存储 DPAPI/TPM<br/>HSM：ProviderClient 经厂商中间件访问"]
            N2T["📊 运行时旁路<br/>/metrics · Serilog 日志 · /health · /live · /ready"]
        end

        BG["🔄 后台任务调度（NodeId 注册 + 分布式锁单实例执行）<br/>密钥状态巡检 · 到期与轮换检查 · 密码设备健康检查<br/>完整性值抽查 · Nonce 临时数据清理 · 告警规则评估"]
    end

    %% ================= ④ 数据存储区 =================
    subgraph Z4["④ 数据存储区 · 主备冗余"]
        direction LR
        DBP["💾 平台数据库 主节点<br/>国产 P0：达梦 DM8 / 人大金仓 KingbaseES / 南大通用 GBase<br/>Key · KeyVersion · KeyMaterial · 密钥状态机<br/>Application · ApplicationSecret · User · UserMfaBinding<br/>Role · Permission · AdminSession · RefreshToken<br/>SignatureNonce · AuditLog · SecurityEvent · AlertRule<br/>CryptoDevice · SystemConfig · BackupRecord<br/>IntegrityValue 全表：HMAC-SM3 + IntegrityKey<br/>审计表按月分区"]
        DBS["💾 平台数据库 备节点<br/>主备复制 · 自动或人工切换<br/>RPO ≤ 5min · RTO ≤ 30min<br/>账号分级最小权限：runtime / migration / audit-readonly / backup"]
        RDP["⚡ 分布式缓存 主节点<br/>信创：东方通 TongRDS / 达梦 CDM / 宝兰德<br/>非信创：Redis · 兼容 Redis 协议<br/>Nonce 防重放 · Token 撤销 · 限流 · 分布式锁<br/>AppSecret 受限内存短缓存 · 临时状态<br/>禁止存放密钥材料与明文敏感数据"]
        RDS["⚡ 分布式缓存 备节点<br/>主从复制 + 哨兵自动切换<br/>缓存故障 → Nonce 回退数据库<br/>以 UNIQUE(AppId, Nonce) 为最终仲裁"]
        BKP["🗄️ 本地备份存储<br/>运行备份 ≥ 90 天 · 审计备份 ≥ 6 个月（建议 3 年）<br/>备份加密 · 归档保留哈希链与校验点<br/>定期恢复验证"]
        DRB["📦 异地备份 · 离线保管<br/>备份介质异地存放<br/>主密码备份不得与数据库/备份介质同地<br/>跨机房 DR 本期建设内容、不纳入本期验收"]
    end

    %% ================= ⑤ 密码设备区 =================
    subgraph Z5["⑤ 密码设备区 · 独立网络"]
        direction LR
        HSM1["🔐 HSM-A 主设备<br/>国密 SM2 / SM3 / SM4 / HMAC-SM3 / RNG<br/>Root of Trust 保护 · 密钥生成与销毁<br/>商用密码产品认证证书核查与临期告警<br/>性能基线 ≥ 200 次/s SM2 签名验签"]
        HSM2["🔐 HSM-B 备设备<br/>主备能力一致 · 故障切换不降低安全等级<br/>同厂商同型号：集群内部密钥同步<br/>异厂商/异型号：按需加载 + 密钥同步服务"]
        SWM["💻 软件密码模块 SoftwareCryptoProvider<br/>【与 HSM 互斥，二选一，不支持混合部署】<br/>允许用于生产环境 · 密评前需与测评机构确认<br/>Root Key：主密码 + KDF 派生 + OS 安全存储<br/>提供与 HSM 完全一致的 Crypto Provider 接口"]
        MPS["🔒 主密码离线保管<br/>物理介质异地保管 · 丢失恢复流程见 F-RK-013"]
    end

    %% ================= ⑥ 统一运维支撑区 =================
    subgraph Z6["⑥ 统一运维支撑区"]
        direction LR
        NTP["⏱️ 统一 NTP / 时间同步服务<br/>签名窗口 ±3min · Token 与 TTL<br/>密钥到期 · 审计时间 · 哈希链<br/>时间源不可用按安全策略拒绝或告警"]
        CFG["🧾 配置中心 / 配置库<br/>环境差异化配置下发<br/>安全配置项以 SystemConfig 为准并纳入完整性校验<br/>MFA · Nonce TTL · 轮换策略 · 保留周期"]
        LOGP["📚 统一日志平台<br/>Serilog 汇聚 · 日志分级 · 审计归档<br/>按月分区 · 日志禁含敏感字段"]
        MQ["📨 消息队列<br/>异步任务 · 审计外发缓冲 · 告警通知重试<br/>非核心组件，不得成为密码服务单点"]
        MON["📈 监控平台 Prometheus + 监控面板<br/>API QPS · P50/P95/P99 · 错误率<br/>HSM 连接与队列 · DB 连接与慢查询<br/>缓存命中率 · 密钥总量与轮换次数<br/>节点 CPU/内存/磁盘/网络"]
        BAST["🖥️ 堡垒机 / 运维审计<br/>等保三级运维操作审计配套<br/>运维与业务网络分离"]
    end

    %% ================= ⑦ 安全合规对接区 =================
    subgraph Z7["⑦ 安全合规对接区 · 等保三级 / 密评"]
        direction LR
        SMC["🛡️ 安全管理中心<br/>集中审计 · 集中告警 · 集中配置<br/>NF-CMP-008 集中管控对接"]
        ANC["📌 外部锚点独立存储<br/>SM2 签名校验点（起始 AuditId · 结束 AuditId · 链头 · 时间戳）<br/>与平台数据库物理隔离<br/>防哈希链尾部删除重构造"]
        CA["🏛️ 国密 CA / 证书与吊销服务<br/>SM2 双证书签发 · 证书链与有效期监控<br/>CRL / OCSP 吊销校验"]
        SMSG["📱 短信网关 / Webhook / 站内通知<br/>告警通道（手机号临时解密，用后立即清零）<br/>通道变更审计 · 通知失败不丢弃事件"]
    end

    %% ================= 连接关系 =================
    BIZ --> FW
    ADM --> FW
    FW --> LB
    LB --> N1W
    LB --> N2W
    LB -.->|国密 TLS 证书与吊销校验| CA

    N1W --> N1A
    N2W --> N2A
    N1A --> N1K
    N2A --> N2K
    N1K --> HSM1
    N2K --> HSM1
    HSM1 -.->|主备切换 · 密钥同步| HSM2
    N1K -.->|部署模式互斥 · 二选一| SWM
    SWM -.->|主密码离线保管| MPS

    N1A <--> DBP
    N2A <--> DBP
    N1A <--> RDP
    N2A <--> RDP
    DBP -.->|主备实时复制 · 自动切换| DBS
    RDP -.->|主从复制 · 哨兵切换| RDS
    DBP --> BKP
    BKP --> DRB

    N1A -.->|触发后台任务| BG
    N2A -.->|触发后台任务| BG
    BG -.->|巡检结果 · 全节点调用计数聚合| DBP
    BG -.->|分布式锁 · NodeId 注册| RDP

    N1T -.-> MON
    N2T -.-> MON
    N1T -.-> LOGP
    N2T -.-> LOGP
    N1A -.->|配置读取| CFG
    N2A -.->|配置读取| CFG
    N1A -.->|时间校验| NTP
    N2A -.->|时间校验| NTP
    LOGP -.->|加密外发 · 断点续传| SMC
    LOGP -.->|校验点写入| ANC
    MON -.->|重大指标异常触发告警| SMSG
    SMSG -.->|集中告警外发| SMC

